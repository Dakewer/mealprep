# Copia este archivo a .env (no se versiona) y cambia JWT_SECRET por un valor propio.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=1h
PORT=3000

# URL del canal WebSocket (la usa el front en src/environments; el servidor comparte el puerto de PORT).
WS_URL=ws://localhost:3000
